// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`
// ─────────────────────────────────────────────────────────────────────────────
// NoDalalTalks — Prisma schema
//
// Two non-negotiable design laws encoded here:
//
//  1. PROVENANCE ON EVERY FACT. Every fact-bearing row carries a `dataSource`
//     (the source-tag: OFFICIAL_GOVERNMENT / BUILDER_INFORMATION /
//     MANUALLY_VERIFIED / AI_GENERATED / USER_SUBMITTED) plus lineage fields.
//     Nothing renders on screen whose origin can't be named.
//
//  2. MANUAL NOW, IGR LATER — WITHOUT A SCHEMA CHANGE. A Transaction row is
//     source-agnostic: a manually-curated transaction and a future
//     IGR-ingested one are THE SAME ROW SHAPE, differing only in `dataSource`,
//     `sourceRef`, `ingestBatchId`, and `confidence`. When live IGR integration
//     lands, it writes to these same tables; manual rows are simply superseded
//     or coexist, tagged by source. No migration required to switch.
//
// Money is stored as BigInt paise (never floats). Areas as Decimal sq ft.
// Geo hierarchy (Country → State → City → Zone → Locality → MicroMarket) is
// multi-tenant so Mumbai-only today expands to Maharashtra / India / global
// by adding rows and flipping flags — never by reshaping tables.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// PROVENANCE — the source-tag system (the product's signature contract)
// ═══════════════════════════════════════════════════════════════════════════

/// The origin class of a data point. Rendered as a visible tag everywhere.
enum DataSource {
  OFFICIAL_GOVERNMENT // IGR / MahaRERA / other official registries (future + any verified-official today)
  BUILDER_INFORMATION // developer-provided: brochures, price lists, amenities
  MANUALLY_VERIFIED // curated from domain expertise / network / public sources (MVP PRIMARY)
  AI_GENERATED // model outputs: summaries, estimates, scores
  USER_SUBMITTED // community-contributed, unverified
  EXTERNAL_OPEN_DATA // public open-data feeds we don't control or curate (OSM, Census) — not an official registry, not ours
}

/// How confident we are in a resolved/curated fact.
enum Confidence {
  HIGH
  MEDIUM
  LOW
}

// ═══════════════════════════════════════════════════════════════════════════
// GEO HIERARCHY — multi-tenant from day one (Mumbai-only is data, not schema)
// ═══════════════════════════════════════════════════════════════════════════

model Country {
  id        String   @id @default(cuid())
  name      String   @unique // "India"
  iso2      String   @unique // "IN"
  currency  String // "INR" — money stored as minor units (paise); generalizes to cents
  states    State[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model State {
  id            String   @id @default(cuid())
  countryId     String
  country       Country  @relation(fields: [countryId], references: [id])
  name          String // "Maharashtra"
  code          String // "MH"
  /// Official RERA portal for the state (MahaRERA) — used by future ingestion.
  reraPortalUrl String?
  cities        City[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([countryId, code])
  @@unique([countryId, name])
}

model City {
  id          String     @id @default(cuid())
  stateId     String
  state       State      @relation(fields: [stateId], references: [id])
  name        String // "Mumbai"
  slug        String     @unique // "mumbai"
  /// Coverage flag. Drives UI, search scope, sitemaps. Mumbai=true, others=false today.
  isLive      Boolean    @default(false)
  /// Centroid for map default view. Lat/lng kept as plain floats (no PostGIS dependency in MVP).
  centroidLat Float?
  centroidLng Float?
  zones       Zone[]
  localities  Locality[]
  projects    Project[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([stateId, name])
}

model Zone {
  id         String     @id @default(cuid())
  cityId     String
  city       City       @relation(fields: [cityId], references: [id])
  name       String // "Western Suburbs", "South Mumbai"
  slug       String
  localities Locality[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([cityId, slug])
}

model Locality {
  id          String  @id @default(cuid())
  cityId      String
  city        City    @relation(fields: [cityId], references: [id])
  zoneId      String?
  zone        Zone?   @relation(fields: [zoneId], references: [id])
  name        String // "Lower Parel", "Bandra West"
  slug        String // unique per city
  pincode     String?
  /// Rich-text editorial description (SEO + the public Locality page), same
  /// HTML convention as Project.description / Builder.description.
  description String?
  centroidLat Float?
  centroidLng Float?

  // ── Market snapshot (curated; same swap-ready pattern as Transaction) ──
  avgPricePerSqftPaise BigInt?
  rentalYieldPercent   Decimal?    @db.Decimal(5, 2)
  growthPercentYoy     Decimal?    @db.Decimal(5, 2)
  marketDataSource     DataSource?
  marketAsOf           DateTime?
  /// Freeform curated summary of road/highway/transit connectivity — the
  /// itemised nearby metro/rail/road/etc. list is derived automatically from
  /// InfraAsset proximity (see getLocalityNearbyInfra), not duplicated here.
  connectivityNotes    String?

  // ── Media ──
  coverImageUrl String?

  // ── Flags — same admin-controlled visibility model as Project/Builder ──
  isPublished Boolean @default(false)
  isFeatured  Boolean @default(false)
  isArchived  Boolean @default(false)

  // ── Trash — separate from isArchived: this is "pending permanent deletion",
  // an admin-only Trash view, not the public/admin-list archive state.
  deletedAt       DateTime?
  deletedByUserId String?

  // ── SEO ──
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImageUrl      String?

  // ── Insights — curated 0-10 scores, current-state (not versioned like
  // Builder's delivery-record snapshots — these describe the place, not a
  // track record over time). ──
  investmentScore Decimal? @db.Decimal(3, 1)
  endUserScore    Decimal? @db.Decimal(3, 1)
  luxuryScore     Decimal? @db.Decimal(3, 1)
  familyScore     Decimal? @db.Decimal(3, 1)
  advantages      String[] @default([])
  disadvantages   String[] @default([])

  aliases      LocalityAlias[]
  microMarkets MicroMarket[]
  projects     Project[]
  transactions Transaction[]
  amenities    LocalityAmenity[]
  images       LocalityImage[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([cityId, slug])
  @@index([zoneId])
  @@index([isPublished])
  @@index([isArchived])
  @@index([deletedAt])
}

model LocalityAmenity {
  id         String   @id @default(cuid())
  localityId String
  locality   Locality @relation(fields: [localityId], references: [id], onDelete: Cascade)
  amenityId  String
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([localityId, amenityId])
  @@index([amenityId])
}

model LocalityImage {
  id         String   @id @default(cuid())
  localityId String
  locality   Locality @relation(fields: [localityId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([localityId, sortOrder])
}

/// Alternate spellings (IGR spellings, colloquial names) — critical for future
/// automated matching. Populated manually today; grows with ingestion later.
model LocalityAlias {
  id         String   @id @default(cuid())
  localityId String
  locality   Locality @relation(fields: [localityId], references: [id], onDelete: Cascade)
  alias      String
  /// Where this spelling comes from (e.g. "IGR", "colloquial").
  source     String?
  createdAt  DateTime @default(now())

  @@index([alias])
}

/// Finer-than-locality grain (Pali Hill within Bandra West). Mumbai needs this;
/// the schema has it now so it's an SEO/analytics surface, not a later migration.
model MicroMarket {
  id         String    @id @default(cuid())
  localityId String
  locality   Locality  @relation(fields: [localityId], references: [id], onDelete: Cascade)
  name       String
  slug       String
  projects   Project[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([localityId, slug])
}

// ═══════════════════════════════════════════════════════════════════════════
// CATALOG — builders & projects
// ═══════════════════════════════════════════════════════════════════════════

model Builder {
  id            String     @id @default(cuid())
  slug          String     @unique
  name          String // "Lodha Group"
  /// Subsidiary / SPV legal names resolved to this one economic builder.
  legalNames    String[]   @default([])
  logoUrl       String?
  /// Wide banner image for the builder's public profile hero.
  coverImageUrl String?
  description   String? // rich-text HTML, same convention as Project.description
  foundedYear   Int?
  headquarters  String?
  websiteUrl    String?
  reraNumber    String?
  /// Notable awards/recognitions — simple curated strings, not a taxonomy.
  awards        String[]   @default([])
  /// Provenance of this builder record.
  dataSource    DataSource @default(MANUALLY_VERIFIED)
  confidence    Confidence @default(HIGH)

  // ── Flags — same admin-controlled visibility model as Project ──
  isPublished Boolean @default(false)
  isFeatured  Boolean @default(false)
  isArchived  Boolean @default(false)

  // ── Trash — separate from isArchived: this is "pending permanent deletion",
  // an admin-only Trash view, not the public/admin-list archive state.
  deletedAt       DateTime?
  deletedByUserId String?

  // ── SEO ──
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  projects       Project[]
  scoreSnapshots BuilderScoreSnapshot[]
  timeline       BuilderTimelineEvent[]
  amenities      BuilderAmenity[]
  images         BuilderImage[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([name])
  @@index([isPublished])
  @@index([isArchived])
  @@index([deletedAt])
}

model BuilderAmenity {
  id        String   @id @default(cuid())
  builderId String
  builder   Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([builderId, amenityId])
  @@index([amenityId])
}

/// Company gallery — office, projects showcase, leadership photos — distinct
/// from the single logo/cover images.
model BuilderImage {
  id        String   @id @default(cuid())
  builderId String
  builder   Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([builderId, sortOrder])
}

/// A single milestone in a builder's history (founding, major delivery,
/// listing, award…), shown as a timeline on the Builder Intelligence page.
model BuilderTimelineEvent {
  id          String   @id @default(cuid())
  builderId   String
  builder     Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  year        Int
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([builderId, year])
}

/// Versioned builder score — never overwritten, so history is reproducible.
model BuilderScoreSnapshot {
  id                 String     @id @default(cuid())
  builderId          String
  builder            Builder    @relation(fields: [builderId], references: [id], onDelete: Cascade)
  asOf               DateTime
  overallScore       Decimal    @db.Decimal(4, 2) // 0–10
  onTimeDeliveryPct  Decimal?   @db.Decimal(5, 2)
  avgDelayMonths     Decimal?   @db.Decimal(5, 1)
  deliveredProjects  Int        @default(0)
  activeProjects     Int        @default(0)
  litigationFlags    Int        @default(0)
  methodologyVersion String
  dataSource         DataSource @default(AI_GENERATED) // computed score is a derived estimate
  createdAt          DateTime   @default(now())

  @@unique([builderId, asOf])
}

enum ProjectStatus {
  ANNOUNCED
  PRE_LAUNCH
  UNDER_CONSTRUCTION
  NEARING_POSSESSION
  READY_TO_MOVE
  DELIVERED
  STALLED
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  PLOT
  MIXED_USE
}

/// India-specific payment-plan structures — replaces the UAE-style ratio
/// (80/20, 30/70…) that doesn't map to how Indian projects are sold.
enum PaymentPlanType {
  CONSTRUCTION_LINKED
  BUILDER_SUBVENTION
  BANK_SUBVENTION
  DOWN_PAYMENT
  FLEXI_PAYMENT
  NO_PAYMENT_PLAN
}

model Project {
  id          String  @id @default(cuid())
  slug        String  @unique // "lodha-park"
  name        String // "Lodha Park"
  tagline     String?
  description String?

  builderId      String?
  builder        Builder? @relation(fields: [builderId], references: [id])
  /// Free-text developer group / holding entity when it differs from the
  /// resolved Builder record (e.g. an SPV name on the RERA filing).
  developerGroup String?

  cityId        String
  city          City         @relation(fields: [cityId], references: [id])
  localityId    String
  locality      Locality     @relation(fields: [localityId], references: [id])
  microMarketId String?
  microMarket   MicroMarket? @relation(fields: [microMarketId], references: [id])

  /// Defaults to the earliest lifecycle stage so an incomplete draft (admin
  /// hasn't chosen a status yet) can still be saved — same pattern as
  /// `category`'s default below, not a new convention.
  status   ProjectStatus    @default(ANNOUNCED)
  category PropertyCategory @default(RESIDENTIAL)

  address        String?
  /// A recognizable nearby landmark ("Near R City Mall", "5 minutes from BKC")
  /// so a buyer can immediately place the project without parsing the address.
  famousLandmark String?
  latitude       Float?
  longitude      Float?
  /// Direct link to the project's actual Google Maps location — what the admin
  /// pastes and what "View on Google Maps" links to everywhere. latitude/
  /// longitude above are auto-parsed from this URL when the format allows
  /// (e.g. an "@lat,lng" or "q=lat,lng" pattern) so the OSM MapEmbed preview
  /// and infra-linking distance calculations keep working without the admin
  /// ever typing coordinates by hand; they stay null if the pasted link is a
  /// shortened form (goo.gl/maps/…) that doesn't expose coordinates.
  googleMapsUrl  String?

  // ── Timeline ──
  launchDate          DateTime?
  promisedPossession  DateTime? // from builder / RERA filing — kept as the DateTime that filters/sort ("possession_asc", the ready/1yr/2yr/later range filter) key off; auto-derived (1st of month) from possessionMonth/possessionYear below whenever an admin sets those, so there is only one place data entry happens
  actualPossession    DateTime? // reality — feeds health & builder score
  /// Buyer-facing possession display, India-localized (month + year, never a UAE-style quarter). Independent of promisedPossession's day-level precision — this is what Project Card / Project Detail / admin preview actually render. Null on legacy records that predate this field; those fall back to deriving month/year from promisedPossession at render time.
  possessionMonth     Int? // 1–12
  possessionYear      Int?
  constructionPercent Int? // 0–100, current progress

  // ── RERA (official when present) ──
  reraNumber         String? @unique
  reraStatus         String?
  /// Direct link to this project's official MahaRERA (or other state RERA)
  /// registration page on the government portal — the actual government
  /// commitment record, not our own reraNumber/reraStatus fields.
  reraCertificateUrl String?

  // ── Scale ──
  totalUnits    Int?
  totalTowers   Int?
  landAreaAcres Decimal? @db.Decimal(8, 2)

  // ── Pricing band (paise) ──
  priceMinPaise BigInt?
  priceMaxPaise BigInt?

  // ── Payment plan (India) ──
  paymentPlanType        PaymentPlanType?
  /// Free text, admin-editable per project (e.g. the actual "10:80:10" split) — the admin form auto-fills a sensible default from PAYMENT_PLAN_TYPE_DEFAULT_DESCRIPTION (lib/project-meta.ts) when paymentPlanType is chosen, but this is what's actually stored and rendered everywhere (card tooltip, detail page) — single source, no separate default lookup at render time.
  paymentPlanDescription String?

  // ── Provenance of the project RECORD itself ──
  dataSource    DataSource @default(MANUALLY_VERIFIED)
  confidence    Confidence @default(HIGH)
  /// Lineage — set now for manual curation, reused verbatim by future ingestion.
  sourceRef     String? // e.g. "manual:analyst-notes-2026", later "rera:P51900012345"
  ingestBatchId String?

  // ── Flags ──
  isPublished            Boolean                  @default(false) // admin-controlled visibility
  isFeatured             Boolean                  @default(false) // admin-curated homepage/spotlight placement
  isArchived             Boolean                  @default(false) // soft-removed from admin/public lists, not hard-deleted
  /// Trash — separate from isArchived: "pending permanent deletion" in the
  /// admin-only Trash view, forced alongside isArchived=true/isPublished=false
  /// so every existing public query (already filtering on those two) needs
  /// no changes to exclude trashed projects.
  deletedAt              DateTime?
  deletedByUserId        String?
  /// Set by an EDITOR to flag a draft as ready for an ADMIN to review before
  /// publishing (Draft → Under Review → Published). Cleared automatically on
  /// publish. Null = not currently in review — independent of isPublished so
  /// existing publish/archive logic never needs to branch on it.
  submittedForReviewAt   DateTime?
  /// Server-computed % of the admin form's required fields that are filled in
  /// (see computeProjectCompletionPercent in lib/project-data.ts) — recomputed
  /// on every create/update/autosave. Purely an admin-side data-quality
  /// indicator; never read by any public query.
  completionPercent      Int                      @default(0)
  /// Merchandising tags. Deliberately NOT duplicating `status` — READY_TO_MOVE
  /// and PRE_LAUNCH ("new launch") are already derivable from `status`; these
  /// three are independent editorial calls a status enum can't express.
  isTrending             Boolean                  @default(false)
  isLuxury               Boolean                  @default(false)
  isAffordable           Boolean                  @default(false)
  /// Current brochure — mirrors the latest row in `brochureVersions` for
  /// cheap reads on the public project page (no join needed to show/hide the
  /// Download Brochure button or its filename). `brochureVersions` is the
  /// source of truth for history; these fields are a denormalized "current
  /// pointer" onto it, updated together on every upload/replace/delete.
  brochureUrl            String?
  brochureFileName       String?
  brochureFileSize       Int?
  brochureMimeType       String?
  brochureUploadedAt     DateTime?
  brochureUploadedBy     String?
  brochureVersion        Int                      @default(0)
  /// Clickable preview image for the brochure download card — a normal
  /// Cloudinary `image` upload (reuses uploadImageFile/deleteImageByPublicId),
  /// distinct from the PDF itself. Optional; falls back to a text/icon
  /// treatment on the public site when absent.
  brochureThumbnailUrl   String?
  brochureVersions       ProjectBrochureVersion[]
  brochureDownloadEvents BrochureDownloadEvent[]

  /// Short bullet differentiators ("5 min to metro", "Sea-facing") shown near
  /// the top of the detail page. Order-preserving list, not a relation — no
  /// row ever needs its own identity, sort order, or edit history.
  highlights String[] @default([])

  // ── Media ──
  videoUrl   String?
  tour360Url String?

  // ── SEO ──
  metaTitle       String?
  metaDescription String?
  ogImageUrl      String?

  // ── Relations ──
  images            ProjectImage[]
  configurations    Configuration[]
  paymentMilestones ProjectPaymentMilestone[]
  amenities         ProjectAmenity[]
  customAmenities   Amenity[]
  transactions      Transaction[]
  priceHistory      PriceHistoryPoint[]
  infraLinks        ProjectInfra[]
  metrics           ProjectMetric[]
  investmentNotes   InvestmentNote[]
  specifications    ProjectSpecification[]
  documents         ProjectDocument[]
  timelineEvents    ProjectTimelineEvent[]
  faqs              ProjectFaq[]
  sections          ProjectSection[]
  savedBy           SavedProject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId, status])
  @@index([localityId])
  @@index([builderId])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([isArchived])
  @@index([deletedAt])
  /// Default sort for every public project listing (getPublicProjectsPaged).
  @@index([updatedAt])
  /// "launch_desc" sort + getLatestLaunches ordering.
  @@index([launchDate])
}

/// A single construction/material spec line ("Structure — RCC shear wall
/// frame"), grouped by `category` for display. Freeform category (not an
/// enum) — spec sheets vary too much project-to-project for a fixed taxonomy.
model ProjectSpecification {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category  String // "Structure", "Flooring", "Doors & Windows", "Kitchen"…
  detail    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

/// Downloadable PDFs beyond the primary brochure (approvals, legal title,
/// floor-plan sheets, master-plan sheets…). `kind` is freeform for the same
/// reason as ProjectSpecification.category.
model ProjectDocument {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  url       String
  kind      String   @default("document")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

/// Brochure version history — a lightweight change-log (view-only, same
/// pattern as AuditLog's before/after diffs used elsewhere), NOT a rollback
/// mechanism. Each upload/replace creates a new row here; the Cloudinary
/// asset a row points to is never deleted on replace (only an explicit
/// "Delete brochure" removes the current file), so older rows keep working
/// download links even after the current brochure changes.
model ProjectBrochureVersion {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version          Int
  url              String
  fileName         String
  fileSize         Int
  mimeType         String
  uploadedAt       DateTime @default(now())
  uploadedByUserId String?

  @@unique([projectId, version])
  @@index([projectId, version])
}

/// One row per brochure funnel event — deliberately event-sourced (never a
/// counter column) so every admin aggregate (totals, trends, top
/// projects/builders/localities, anonymous-vs-logged-in, returning
/// downloaders) is *derived* from these rows, not maintained by hand.
/// builderId/localityId/microMarketId are denormalized snapshots of the
/// project's values at event time — purely a read-performance shortcut so
/// "top builders by downloads" never needs a join back through Project on
/// the Neon HTTP adapter (which has no query planner to lean on); they are
/// never treated as a live foreign key and are safe to leave stale if a
/// project's builder/locality changes later. Generic enough (event type +
/// actor identity + device/geo context) to back AI recommendations, lead
/// scoring, or demand-forecasting later without a schema change — only new
/// read queries would be needed.
model BrochureDownloadEvent {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  builderId     String?
  localityId    String?
  microMarketId String?

  /// "VIEWED" | "DOWNLOAD_STARTED" | "DOWNLOAD_COMPLETED" | "DOWNLOAD_FAILED"
  eventType String
  /// Set on DOWNLOAD_COMPLETED when this identity (publicUserId or, if
  /// anonymous, sessionId) already has an earlier completed download of the
  /// same project's brochure.
  isRepeat  Boolean @default(false)

  publicUserId String?
  /// Anonymous visitor id (lib/analytics/session-id.ts) — first-party cookie,
  /// no cross-site tracking. Lets "returning downloader" detection work for
  /// guests too, not just signed-in users.
  sessionId    String?
  ipAddress    String?
  device       String?
  browser      String?
  os           String?
  country      String?
  city         String?
  referrer     String?
  landingPage  String?
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([builderId, createdAt])
  @@index([localityId, createdAt])
  @@index([microMarketId, createdAt])
  @@index([eventType, createdAt])
  @@index([publicUserId])
  @@index([sessionId])
}

/// Construction-progress milestones shown on the detail page timeline —
/// distinct from BuilderTimelineEvent, which is the builder's own history.
model ProjectTimelineEvent {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String // "Foundation complete", "Possession handed over"
  description String?
  eventDate   DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([projectId, sortOrder])
}

model ProjectFaq {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId, sortOrder])
}

/// Editorial rich-text blocks beyond the fixed `description` field ("Why
/// this location", "About the neighbourhood"…) — an open-ended CMS surface
/// so new narrative sections never require a schema change.
model ProjectSection {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  bodyHtml  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, sortOrder])
}

model ProjectImage {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  kind       String     @default("hero") // hero | gallery | floorplan | elevation
  sortOrder  Int        @default(0)
  dataSource DataSource @default(BUILDER_INFORMATION)
  createdAt  DateTime   @default(now())

  @@index([projectId, sortOrder])
}

/// Unit configurations (2BHK / 3BHK …) with carpet area and price band.
model Configuration {
  id            String     @id @default(cuid())
  projectId     String
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label         String // "2 BHK", "3 BHK", "4 BHK Duplex"
  bedrooms      Decimal    @db.Decimal(3, 1) // 1, 1.5, 2, 2.5 …
  carpetSqft    Decimal?   @db.Decimal(9, 2)
  builtUpSqft   Decimal?   @db.Decimal(9, 2)
  priceMinPaise BigInt?
  priceMaxPaise BigInt?
  dataSource    DataSource @default(BUILDER_INFORMATION)
  confidence    Confidence @default(MEDIUM)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([projectId, sortOrder])
}

/// A single payment milestone in a project's payment schedule ("Booking",
/// "Agreement", "10% on Slab Completion", or a fully custom entry). Layered
/// on top of Project.paymentPlanType/paymentPlanDescription (the overall plan
/// *category* + free-text summary, unchanged) rather than replacing them —
/// this is the granular, individually addable/editable/deletable schedule
/// developers actually vary milestone-by-milestone.
model ProjectPaymentMilestone {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String // "Booking" | "Agreement" | "Plinth" | "Slab Completion" | "Possession" | custom text
  percentage  Decimal? @db.Decimal(5, 2)
  amountPaise BigInt?
  /// false only when `label` exactly matches one of the five preset
  /// milestone names — computed server-side on save, never trusted from the client.
  isCustom    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, sortOrder])
}

/// Master amenity list (Swimming Pool, Clubhouse, 24x7 Security…). A shared
/// table rather than a free-text array so amenities are filterable/searchable
/// consistently across every project.
model Amenity {
  id         String            @id @default(cuid())
  slug       String            @unique
  name       String
  icon       String? // icon key resolved client-side, no binary asset stored
  /// Plain text, not an enum -- admins can group amenities under their own custom section name
  /// (e.g. "Kids Zone") in addition to the built-in ones (Recreation, Safety & Security,
  /// Convenience, Wellness, Utilities, Outdoor). See AMENITY_CATEGORY_LABEL in
  /// lib/project-meta.ts, which only has entries for the built-in set -- anything else
  /// displays as typed.
  category   String            @default("CONVENIENCE")
  /// Null (the default) = the shared catalogue described above. Set only when an admin adds
  /// a one-off amenity via the Project form's "+ New Amenity" inline-create -- that row is
  /// private to this project, never shown in the shared list or any other project's picker.
  /// Builder/Locality's own "+ New Amenity" path never sets this, unaffected either way.
  projectId  String?
  project    Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projects   ProjectAmenity[]
  builders   BuilderAmenity[]
  localities LocalityAmenity[]
  createdAt  DateTime          @default(now())

  @@index([category])
  @@index([projectId])
}

model ProjectAmenity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, amenityId])
  @@index([amenityId])
}

// ═══════════════════════════════════════════════════════════════════════════
// MARKET DATA — the transaction (source-agnostic: manual now, IGR later)
// ═══════════════════════════════════════════════════════════════════════════

enum TransactionType {
  SALE
  RESALE
  LEASE
}

enum BuyerType {
  INDIVIDUAL
  COMPANY
}

/// A single registered/recorded transaction.
///
/// THE SWAP-READY MODEL. Today rows are `MANUALLY_VERIFIED` (curated). When
/// live IGR integration lands it writes rows of THIS EXACT SHAPE tagged
/// `OFFICIAL_GOVERNMENT`, with `sourceRef` = registry doc number and
/// `ingestBatchId` set. The application, API, and UI never change — they read
/// the same fields and render the source tag. `@@unique([dataSource, sourceRef])`
/// makes future ingestion idempotent without touching manual rows.
model Transaction {
  id         String   @id @default(cuid())
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id])
  localityId String
  locality   Locality @relation(fields: [localityId], references: [id])

  type             TransactionType @default(SALE)
  registrationDate DateTime

  // ── The facts (money in paise, area in sqft) ──
  valuePaise        BigInt
  carpetSqft        Decimal?   @db.Decimal(10, 2)
  builtUpSqft       Decimal?   @db.Decimal(10, 2)
  pricePerSqftPaise BigInt? // derived + stored for query speed
  bedrooms          Decimal?   @db.Decimal(3, 1)
  floor             Int?
  tower             String?
  unitLabel         String? // "A-1204"
  buyerType         BuyerType?

  // ── Provenance & lineage (the swap contract) ──
  dataSource    DataSource @default(MANUALLY_VERIFIED)
  confidence    Confidence @default(MEDIUM)
  /// For manual: a note/reference. For IGR: the registry document number.
  sourceRef     String?
  ingestBatchId String?
  /// Free-text note on where a manual figure came from (network, deal sheet…).
  sourceNote    String?

  /// Trash — Transaction has no isPublished/isArchived (market data is live
  /// immediately, no editorial gate), so unlike Project/Builder/Locality this
  /// DOES require its own explicit `deletedAt: null` filter in every public
  /// query (lib/queries/index.ts, map.ts, transactions.ts).
  deletedAt       DateTime?
  deletedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Idempotency key: same (source, ref) never duplicates. NULL sourceRef allowed
  // for manual rows without a formal reference; those are dedupe-exempt.
  @@unique([dataSource, sourceRef])
  @@index([projectId, registrationDate])
  @@index([localityId, registrationDate])
  @@index([registrationDate])
  @@index([deletedAt])
  /// "price_desc"/"price_asc" sort + price range filters on /transactions.
  @@index([valuePaise])
  /// "ppsf_desc" sort on /transactions.
  @@index([pricePerSqftPaise])
}

/// Monthly price series per project (observed / curated). Same swap logic:
/// manual points today, IGR-derived points later, all tagged.
model PriceHistoryPoint {
  id                   String     @id @default(cuid())
  projectId            String
  project              Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  month                DateTime // first of month
  avgPricePerSqftPaise BigInt
  sampleSize           Int        @default(0) // # transactions behind the point (0 = curated estimate)
  dataSource           DataSource @default(MANUALLY_VERIFIED)
  confidence           Confidence @default(MEDIUM)
  createdAt            DateTime   @default(now())

  @@unique([projectId, month])
  @@index([projectId, month])
}

/// Pre-computed / curated project-level metrics that power the Intelligence
/// Page (demand score, health score, market-trend %, avg ppsf…). Each metric
/// is a named row so new metrics are new rows, not new columns.
model ProjectMetric {
  id                 String     @id @default(cuid())
  projectId          String
  project            Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key                String // "demand_score" | "health_score" | "market_trend_pct" | "avg_ppsf_paise"
  /// Numeric value. Interpretation depends on `key` (documented in code).
  valueNumeric       Decimal?   @db.Decimal(18, 2)
  /// Optional string value / band (e.g. health band "A", trend label).
  valueText          String?
  unit               String? // "score_0_100" | "bps" | "paise" | "percent"
  dataSource         DataSource @default(AI_GENERATED)
  confidence         Confidence @default(MEDIUM)
  methodologyVersion String?
  asOf               DateTime   @default(now())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([projectId, key])
  @@index([projectId])
}

/// AI Investment Summary + pros/cons, stored so it's cached and inspectable.
model InvestmentNote {
  id         String     @id @default(cuid())
  projectId  String
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       String // "summary" | "pro" | "con"
  body       String
  dataSource DataSource @default(AI_GENERATED)
  confidence Confidence @default(MEDIUM)
  sortOrder  Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([projectId, kind, sortOrder])
}

// ═══════════════════════════════════════════════════════════════════════════
// INFRASTRUCTURE — metro, schools, hospitals, malls, connectivity
// ═══════════════════════════════════════════════════════════════════════════

enum InfraType {
  METRO_STATION
  RAILWAY_STATION
  SCHOOL
  HOSPITAL
  MALL
  AIRPORT
  ROAD
  BUSINESS_DISTRICT
  PARK
  RESTAURANT
}

model InfraAsset {
  id            String         @id @default(cuid())
  cityId        String
  type          InfraType
  name          String
  latitude      Float?
  longitude     Float?
  /// e.g. metro line name, hospital speciality, mall anchor.
  detail        String?
  status        String         @default("operational") // operational | under_construction | planned
  dataSource    DataSource     @default(OFFICIAL_GOVERNMENT)
  /// Idempotency key for ingestion (e.g. "osm:node/123456"). Null for manually
  /// entered rows — same swap-ready pattern as Transaction.sourceRef.
  sourceRef     String?        @unique
  ingestBatchId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projectLinks  ProjectInfra[]

  @@index([cityId, type])
}

/// Precomputed proximity of an infra asset to a project (distance + walk time).
model ProjectInfra {
  id             String     @id @default(cuid())
  projectId      String
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  infraId        String
  infra          InfraAsset @relation(fields: [infraId], references: [id], onDelete: Cascade)
  distanceMeters Int
  walkMinutes    Int?
  dataSource     DataSource @default(MANUALLY_VERIFIED)
  createdAt      DateTime   @default(now())

  @@unique([projectId, infraId])
  @@index([projectId, distanceMeters])
}

// ═══════════════════════════════════════════════════════════════════════════
// IDENTITY — admin auth for manual data management (MVP)
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  EDITOR // can manage data, cannot manage users
  VIEWER
}

model User {
  id                    String                    @id @default(cuid())
  email                 String                    @unique
  name                  String?
  passwordHash          String
  /// Separate step-up credential gating Trash (never the same as passwordHash) — null until the
  /// founder completes first-time setup (lib/actions/trash-auth.ts's setupTrashPasswordAction),
  /// at which point Trash's reauth prompt switches from "set up" to "enter" mode.
  trashPasswordHash     String?
  role                  UserRole                  @default(EDITOR)
  /// Fine-grained permission keys (e.g. "projects.edit", "reports.reject") layered
  /// on top of `role` for an EDITOR/VIEWER — see lib/auth/permissions.ts for the
  /// full key list and hasPermission()'s enforcement. ADMIN always bypasses this
  /// (role check alone is sufficient), so the array is only ever consulted for
  /// non-ADMIN accounts. Ignored entirely until a non-ADMIN user actually exists.
  permissions           String[]                  @default([])
  isActive              Boolean                   @default(true)
  lastLoginAt           DateTime?
  auditLogs             AuditLog[]
  resetTokens           AdminPasswordResetToken[]
  notifications         Notification[]
  emailCampaigns        EmailCampaign[]
  notificationCampaigns NotificationCampaign[]
  pendingChanges        PendingChange[]           @relation("PendingChangeActor")
  reviewedChanges       PendingChange[]           @relation("PendingChangeReviewer")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
}

enum PendingChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The employee-change approval queue (Section 7's "Employee makes change ->
/// pending -> Founder reviews -> approves/rejects -> only then final"). Shape
/// deliberately mirrors AuditLog (actor/action/entityType/entityId/before/after)
/// since this IS an audit-trail row, just one that starts unapplied — on
/// approval the queued change is applied AND a normal AuditLog row is written
/// for the permanent record, so AuditLog never has to distinguish "did this
/// actually happen" after the fact.
model PendingChange {
  id               String              @id @default(cuid())
  actorId          String
  actor            User                @relation("PendingChangeActor", fields: [actorId], references: [id])
  action           String
  entityType       String
  entityId         String?
  before           Json?
  after            Json?
  status           PendingChangeStatus @default(PENDING)
  reviewedByUserId String?
  reviewer         User?               @relation("PendingChangeReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime            @default(now())

  @@index([status, createdAt])
  @@index([actorId])
}

/// Every admin mutation is recorded — provenance discipline applies to the
/// people maintaining the data too.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String // "project.create", "transaction.update", "project.publish"…
  entityType String
  entityId   String
  before     Json?
  after      Json?
  at         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([at])
}

/// Small, generic admin-editable key-value config -- no config-persistence
/// layer exists anywhere else (site config today is exclusively env vars).
/// Deliberately generic (not a single-purpose "review links" table) so a
/// future admin-configurable value is a new row, not a new migration.
/// Seeded keys: "review_google_url", "review_appstore_url".
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// One row per daily storage-monitoring snapshot (see app/api/cron/storage-snapshot),
/// giving the admin System Health page a real growth trend without needing a
/// separate metrics/observability system. dbSizeBytes comes from Postgres's own
/// pg_database_size(); cloudinary* fields come from Cloudinary's Admin API
/// usage() call. Nullable because either provider call can fail independently
/// and a snapshot should still record whatever it could get.
model StorageSnapshot {
  id                           String   @id @default(cuid())
  capturedAt                   DateTime @default(now())
  dbSizeBytes                  BigInt?
  cloudinaryStorageBytes       BigInt?
  cloudinaryObjectCount        Int?
  /// Cloudinary's own reported percentage of plan credits used, when the
  /// account has a knowable plan limit -- null otherwise (never estimated/guessed).
  cloudinaryCreditsUsedPercent Decimal? @db.Decimal(5, 2)

  @@index([capturedAt])
}

enum ReportStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  RESOLVED
}

enum ContactEnquiryStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

/// A Contact Us submission -- previously fire-and-forget (an email to the
/// founder's inbox, lib/email.ts's sendContactMessageEmail, nothing kept in
/// the database). This is the persisted, admin-manageable record; the email
/// notification stays as-is alongside it.
model ContactEnquiry {
  id              String               @id @default(cuid())
  name            String
  email           String
  phone           String?
  subject         String?
  message         String
  publicUserId    String?
  publicUser      PublicUser?          @relation(fields: [publicUserId], references: [id], onDelete: SetNull)
  sourcePage      String?
  status          ContactEnquiryStatus @default(NEW)
  adminNotes      String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  deletedByUserId String?

  @@index([status, createdAt])
  @@index([deletedAt])
}

/// A visitor-submitted "this looks wrong" report — extends the existing
/// Report-an-issue flow (lib/actions/report-issue.ts, which already emails
/// the founder) with real persistence, so it becomes a founder-admin queue
/// instead of only an inbox message. No `fieldKey`-to-Prisma-column mapping:
/// "current value" is always read live from the entity at admin-review time,
/// never duplicated/stored here, and correcting a value happens through the
/// entity's own existing edit form (the one validated write path), not a
/// generic auto-writer — this row is a signal, not a second source of truth.
model Report {
  id               String       @id @default(cuid())
  entityType       String // "Project" | "Builder" | "Locality" — same convention as AuditLog/Wishlist
  entityId         String?
  /// Display snapshot — survives the entity being renamed or deleted later.
  entityName       String
  entityUrl        String
  category         String? // "PROJECT_DETAILS" | "PRICING" | "CONFIGURATION" | "LOCATION" | "CONSTRUCTION" | "AMENITIES" | "BUILDER" | "TRANSACTION" | "OTHER"
  issue            String // "what's wrong"
  suggestedValue   String? // "what it should be"
  reporterUserId   String?
  reporterEmail    String?
  status           ReportStatus @default(NEW)
  reviewedByUserId String?
  reviewedAt       DateTime?
  resolutionNote   String?
  createdAt        DateTime     @default(now())

  @@index([entityType, entityId])
  @@index([status, createdAt])
}

enum NotificationType {
  REPORT_RECEIVED
  REPORT_UNDER_REVIEW
  REPORT_ACCEPTED
  REPORT_REJECTED
  REPORT_RESOLVED
  ADMIN_NEW_REPORT
  ADMIN_REPORT_UNRESOLVED
  CONTACT_ENQUIRY_RECEIVED
  CONTACT_ENQUIRY_IN_PROGRESS
  CONTACT_ENQUIRY_WAITING_FOR_USER
  CONTACT_ENQUIRY_RESPONSE
  CONTACT_ENQUIRY_RESOLVED
  CONTACT_ENQUIRY_CLOSED
  CONTACT_ENQUIRY_REOPENED
  ADMIN_NEW_ENQUIRY
  /// Cloudinary (or, later, another provider) usage crossed a WATCH/WARNING/CRITICAL threshold.
  ADMIN_STORAGE_WARNING
  /// A user asked to verify their phone (lib/actions/phone-verification.ts). No live OTP
  /// provider exists yet -- an admin confirms out-of-band and sets PublicUser.phoneVerifiedAt
  /// manually today; this notification is how they find out someone asked.
  ADMIN_PHONE_VERIFICATION_REQUESTED
  /// Every founder-authored NotificationCampaign send uses this one type -- the specific
  /// classification (new launch, price offer, trending locality, ...) lives on
  /// NotificationCampaign.category instead, so this stays a single generic value rather
  /// than one enum member per category (which NotificationCategory already covers).
  CAMPAIGN_ANNOUNCEMENT
}

/// One shared table for both audiences (public researcher + founder admin)
/// rather than two near-duplicate tables -- same polymorphic-FK convention
/// already used elsewhere in this schema (e.g. Wishlist.entityType/entityId).
/// Exactly one of recipientPublicUserId/recipientAdminUserId is set per row.
/// Real `readAt` column (not a client-side localStorage timestamp, unlike
/// the admin Activity panel's existing pattern) because this needs to survive
/// across devices/sessions for an actual user-facing feature.
model Notification {
  id                    String                @id @default(cuid())
  type                  NotificationType
  title                 String
  body                  String
  recipientPublicUserId String?
  recipientPublicUser   PublicUser?           @relation(fields: [recipientPublicUserId], references: [id], onDelete: Cascade)
  recipientAdminUserId  String?
  recipientAdminUser    User?                 @relation(fields: [recipientAdminUserId], references: [id], onDelete: Cascade)
  /// "Report" today; kept generic so a future notification source is a new value, not a schema change.
  entityType            String?
  entityId              String?
  /// Denormalized from NotificationCampaign at send time (campaign sends only, otherwise
  /// null) -- every recipient's action target is identical, so copying it here means every
  /// existing read of Notification (the bell's poll, getAdminNotifications, ...) stays a
  /// plain findMany with no new join, instead of every call site needing to include campaign.
  imageUrl              String?
  actionLabel           String?
  actionUrl             String?
  readAt                DateTime?
  /// Set when the recipient clicks the notification's action button (campaign sends only) --
  /// the real per-notification signal a NotificationCampaign's "Clicked" count is derived from.
  clickedAt             DateTime?
  /// Set only for a founder-authored bulk send -- Notification stays the single source of
  /// truth for both system notifications (report/enquiry lifecycle, campaignId null) and
  /// campaign sends, rather than a second recipient table like EmailCampaignRecipient: a
  /// campaign Notification already has everything a recipient row needs (readAt, and now
  /// clickedAt), so a parallel table would just duplicate it.
  campaignId            String?
  campaign              NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now())

  @@index([recipientPublicUserId, readAt])
  @@index([recipientAdminUserId, readAt])
  @@index([campaignId])
}

enum NotificationCategory {
  NEW_LAUNCH
  PRICE_OFFER
  TRENDING_LOCALITY
  NEW_REPORT
  MARKET_INSIGHT
  TRANSACTION_DATA
  SAVED_SEARCH_ANNOUNCEMENT
  PRODUCT_UPDATE
  GENERAL_UPDATE
  /// Founder-defined free text lives in NotificationCampaign.customCategory, same split as
  /// NotificationType.CAMPAIGN_ANNOUNCEMENT (a single generic enum value + the real
  /// classification stored alongside it) rather than widening this enum per one-off need.
  OTHER
}

enum NotificationCampaignStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
}

/// Founder-authored in-platform notification send -- NOT email (see
/// EmailCampaign for that, a deliberately separate system). Mirrors
/// EmailCampaign's shape (parent campaign + recipientCount/status/sentAt)
/// but needs no child recipient table, since Notification rows already
/// carry campaignId/readAt/clickedAt per recipient (see the comment there).
model NotificationCampaign {
  id              String                     @id @default(cuid())
  category        NotificationCategory
  /// Only set (and only meaningful) when category is OTHER -- the founder's own label for a
  /// notification type that doesn't fit the fixed list, kept for analytics/history exactly like
  /// the category itself.
  customCategory  String?
  title           String
  message         String
  imageUrl        String?
  actionLabel     String?
  actionUrl       String?
  /// The resolved targeting filter set at send time (segment + any locality/budget/etc.
  /// selections) -- kept for the campaign's own history record, same reasoning as
  /// EmailCampaign not storing a separate "audience definition" row.
  targetFilters   Json?
  status          NotificationCampaignStatus @default(DRAFT)
  createdByUserId String
  createdByUser   User                       @relation(fields: [createdByUserId], references: [id])
  recipientCount  Int                        @default(0)
  sentAt          DateTime?
  createdAt       DateTime                   @default(now())

  notifications Notification[]

  @@index([status, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// PUBLIC AUTHENTICATION — completely separate from the Founder Admin `User`/
// `UserRole` models above. Public visitors authenticate as `PublicUser`, never
// touch `/admin`, and an admin `User` never touches `/login`. Sharing a table
// would conflate "can edit the catalog" with "browses the public site."
// ═══════════════════════════════════════════════════════════════════════════

/// CREDENTIALS and GOOGLE today; MOBILE_OTP is designed for but not built —
/// adding it later is a new enum value + a new lib/public-auth/otp.ts, not a
/// schema change (`phone` already exists, `passwordHash` is already nullable).
enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

model PublicUser {
  id                       String       @id @default(cuid())
  name                     String?
  email                    String       @unique
  phone                    String?      @unique
  /// Where the user themself is based -- distinct from any Project's city,
  /// and from preferences (what they're researching). Free text, optional.
  city                     String?
  currentLocality          String?
  /// Null for OAuth-only accounts (e.g. Google sign-up with no password set).
  passwordHash             String?
  provider                 AuthProvider @default(CREDENTIALS)
  /// Google's `sub` claim — null until the account is linked to Google.
  googleId                 String?      @unique
  /// Google's profile photo URL — the only current source of an avatar; null for credentials-only accounts (Navbar falls back to initials).
  image                    String?
  emailVerifiedAt          DateTime?
  /// Optional trust/identity layer, never a lead-gen mechanism -- set only
  /// after the user explicitly opts in and confirms (see lib/actions/phone-verification.ts).
  /// No live OTP provider is wired up yet (see AuthProvider's MOBILE_OTP note
  /// above); until one exists this is set manually by an admin after an
  /// out-of-band confirmation. Never used to gate browsing/research.
  phoneVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  /// Recomputed by lib/profile-completion.ts whenever a scored field changes
  /// (name/phone/emailVerifiedAt here, or UserPreferences' budget/locality/
  /// category) — never hand-edited elsewhere.
  profileCompletionPercent Int          @default(0)
  /// Stable per-user shareable code (e.g. "USER123"), generated once at
  /// signup for every account regardless of signup path. Powers /?ref=CODE.
  referralCode             String?      @unique
  /// Who referred this account, resolved from the mi_ref_code cookie
  /// (first-touch, set in app/page.tsx) at signup time -- null if this user
  /// arrived without a referral link. Self-relation, not a new table: a
  /// referral is just "which existing user's code resolved this signup."
  referredByUserId         String?
  referredBy               PublicUser?  @relation("Referrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals                PublicUser[] @relation("Referrals")
  /// Which channel the referral link that brought this user in was shared
  /// through ("whatsapp" | "copy_link" | "native_share"), if known.
  referralSource           String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  resetTokens             PublicPasswordResetToken[]
  savedProjects           SavedProject[]
  wishlist                Wishlist[]
  recentViews             RecentView[]
  savedSearches           SavedSearch[]
  searchHistory           SearchHistory[]
  preferences             UserPreferences?
  notificationPreferences NotificationPreferences?
  newsletterSubscriptions NewsletterSubscriber[]
  researchEvents          ResearchEvent[]
  notifications           Notification[]
  emailCampaignRecipients EmailCampaignRecipient[]
  contactEnquiries        ContactEnquiry[]

  @@index([provider])
  @@index([referredByUserId])
}

/// A public user's bookmarked project — the "Saved Projects" list on /account.
model SavedProject {
  id           String     @id @default(cuid())
  publicUserId String
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([publicUserId, projectId])
  @@index([publicUserId])
}

/// Short-lived, single-use tokens for the forgot-password flow. The token
/// itself is never stored — only its hash — so a leaked database row can't be
/// replayed as a live reset link.
model PublicPasswordResetToken {
  id        String     @id @default(cuid())
  userId    String
  user      PublicUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String     @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId])
}

/// Same shape as PublicPasswordResetToken, kept as a separate table because the
/// founder/staff account it resets (User) is a distinct table with its own FK,
/// not because the reset semantics differ.
model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// INGESTION — the automated-import pipeline. IngestSource is the registry
// backing the Admin Sync Dashboard's buttons; every run is an IngestBatch;
// every record touched gets an IngestLogEntry; anything ambiguous (a possible
// duplicate, or any change to an existing row) waits in IngestStagingRecord
// for a human to approve — imports never silently overwrite curated data.
// ═══════════════════════════════════════════════════════════════════════════

/// One registered connector (e.g. "osm-locality-infra"). Disabled sources are
/// skipped by the cron sweep but still triggerable manually from the dashboard.
model IngestSource {
  id           String    @id @default(cuid())
  key          String    @unique // "osm-locality-infra" | "igr-maharashtra" | "maharera" | "manual-import"
  label        String
  kind         String // "API" | "DATASET_UPLOAD" | "MANUAL"
  enabled      Boolean   @default(true)
  scheduleCron String? // informational — the actual schedule lives in vercel.json
  config       Json?
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model IngestBatch {
  id                String    @id @default(cuid())
  sourceKey         String // "igr-maharashtra" | "maharera" | "manual-import"
  trigger           String    @default("manual") // "manual" | "scheduled"
  triggeredByUserId String?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  status            String    @default("pending") // pending | running | success | failed
  recordsWritten    Int       @default(0)
  recordsSkipped    Int       @default(0)
  recordsFailed     Int       @default(0)
  note              String?

  logEntries     IngestLogEntry[]
  stagingRecords IngestStagingRecord[]

  @@index([sourceKey, startedAt])
}

/// Per-record outcome of a batch — the "View Import Logs" detail view.
model IngestLogEntry {
  id         String      @id @default(cuid())
  batchId    String
  batch      IngestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entityType String // "InfraAsset" | "Project" | "Builder" | "Transaction" …
  entityId   String?
  action     String // "CREATED" | "UPDATED" | "SKIPPED_DUPLICATE" | "STAGED" | "FAILED"
  message    String?
  createdAt  DateTime    @default(now())

  @@index([batchId])
}

/// A proposed create/update waiting on admin review — populated when a
/// connector finds a likely duplicate of an existing row, or when a source's
/// policy requires human approval before writing at all.
model IngestStagingRecord {
  id                 String      @id @default(cuid())
  batchId            String
  batch              IngestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entityType         String
  /// Null = proposed create. Set = proposed merge into this existing row.
  targetId           String?
  payload            Json
  matchedExistingId  String?
  matchConfidence    Decimal?    @db.Decimal(4, 3)
  status             String      @default("PENDING") // PENDING | APPROVED | REJECTED | ROLLED_BACK
  reviewedByUserId   String?
  reviewedAt         DateTime?
  /// The Project/Builder/Locality/Transaction row this record's approval actually wrote to
  /// (created or merged into) -- set at approval time, so a later rollback can find it without
  /// re-deriving it from payload/targetId. Null for records approved before this field existed.
  appliedEntityId    String?
  rolledBackAt       DateTime?
  rolledBackByUserId String?
  createdAt          DateTime    @default(now())

  @@index([status, createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// PUBLIC USER INTELLIGENCE DASHBOARD — Wishlist/RecentView use the same
// entityType+entityId string-pair convention already established by
// AuditLog/IngestLogEntry/IngestStagingRecord above, specifically so a
// future entity type (InfraAsset, a Consultation, an AI recommendation …)
// is a new string value, never a schema change. `SavedProject` (already
// shipped, above) stays exactly as-is for Projects; `Wishlist` covers every
// OTHER bookmarkable entity (Builder/Locality today, Report later) rather
// than migrating already-working Project bookmarks onto a new table.
// ═══════════════════════════════════════════════════════════════════════════

/// A public user's bookmarked Builder/Locality (Projects use the existing
/// SavedProject table above, unchanged). One generic table per the same
/// entityType+entityId convention as AuditLog, so a future bookmarkable
/// entity (e.g. a Report) is a new entityType value, not a new table.
model Wishlist {
  id           String     @id @default(cuid())
  publicUserId String
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  entityType   String // "Builder" | "Locality" | "Report" (future)
  entityId     String
  createdAt    DateTime   @default(now())

  @@unique([publicUserId, entityType, entityId])
  @@index([publicUserId])
}

/// "Continue Research" — every Project/Builder/Locality/Transaction/
/// MarketReport a logged-in user has opened, newest first. The compound
/// unique constraint is what makes re-viewing an update, not a new row —
/// see recordRecentViewAction (lib/actions/recent-views.ts) for the
/// find-then-update-or-create that enforces this (Neon's HTTP adapter has
/// no native upsert()).
model RecentView {
  id           String     @id @default(cuid())
  publicUserId String
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  entityType   String // "Project" | "Builder" | "Locality" | "Transaction" | "MarketReport"
  entityId     String
  viewedAt     DateTime   @default(now())

  @@unique([publicUserId, entityType, entityId])
  @@index([publicUserId, viewedAt])
}

/// A saved filter combination ("2 BHK Andheri", "Luxury Bandra") a user can
/// re-run from their dashboard. `notifyOnMatch`/`lastNotifiedAt` are the
/// hook a future matching+alert job would use — no such job exists yet
/// (see docs), so these are write-only today, not a live promise.
model SavedSearch {
  id             String     @id @default(cuid())
  publicUserId   String
  publicUser     PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  label          String
  /// The raw filter query params (q/locality/status/category/priceMin/… —
  /// same shape as PublicProjectFilters), stored as-is so re-running a
  /// search never drifts from what /projects itself already accepts.
  filtersJson    Json
  notifyOnMatch  Boolean    @default(false)
  lastNotifiedAt DateTime?
  createdAt      DateTime   @default(now())

  @@index([publicUserId])
}

/// Server-persisted search history for logged-in users (syncs across
/// devices) — distinct from lib/recent-searches.ts's localStorage-only
/// history for anonymous visitors, which is untouched by this model.
model SearchHistory {
  id           String     @id @default(cuid())
  publicUserId String
  publicUser   PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  query        String
  searchedAt   DateTime   @default(now())

  @@index([publicUserId, searchedAt])
  @@index([query])
}

/// Collected now for future personalization (a personalized home feed, AI
/// recommendations) — nothing reads this to change what a user sees yet;
/// it's real, user-editable data, not a placeholder.
model UserPreferences {
  id                       String     @id @default(cuid())
  publicUserId             String     @unique
  publicUser               PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  preferredBudgetMinRupees Int?
  preferredBudgetMaxRupees Int?
  /// Structured picks from the existing Locality catalog (dropdown/checkbox selection).
  preferredLocalityIds     String[]   @default([])
  /// Multi-select, same reasoning as preferredConfigurations below — a user
  /// researching can be open to more than one property type at once.
  preferredCategories      String[]   @default([])
  /// BHK bucket values ("1"|"2"|"3"|"4"), same value shape as
  /// lib/project-meta.ts's CONFIGURATION_FILTER_OPTIONS -- multi-select, not
  /// a single value, since a user can be open to more than one size.
  preferredConfigurations  String[]   @default([])
  /// "READY_TO_MOVE" | "UNDER_CONSTRUCTION" | "NEW_LAUNCH" -- multi-select.
  preferredReadiness       String[]   @default([])
  /// "SELF_USE" | "INVESTMENT" -- multi-select, a user can be both.
  purposes                 String[]   @default([])
  /// Free-text location interest ("Near Kurla station", "BKC") -- deliberately
  /// separate from preferredLocalityIds (the structured catalog picks) so a
  /// landmark/area with no Locality record yet is never forced into one.
  localityFreeText         String[]   @default([])
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt
}

/// Notification channel toggles. No notification is actually sent by
/// anything in this codebase today (see docs/governance-standards.md's
/// Event & Change Policy) — this table exists so the setting has somewhere
/// real to live the moment a sending job is built, without a schema change.
model NotificationPreferences {
  id                String     @id @default(cuid())
  publicUserId      String     @unique
  publicUser        PublicUser @relation(fields: [publicUserId], references: [id], onDelete: Cascade)
  savedSearchAlerts Boolean    @default(true)
  weeklyDigest      Boolean    @default(true)
  productUpdates    Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

/// The "Stay Ahead of the Market" weekly research newsletter — email-only
/// signup (Footer). Separate from PublicUser (subscribing never requires an
/// account); `publicUserId` links it when the subscriber happens to also be
/// signed in, purely for the founder-dashboard "how many subscribers are
/// also registered users" view, not a functional dependency.
model NewsletterSubscriber {
  id             String           @id @default(cuid())
  /// The uniqueness boundary — one row per distinct email address.
  /// Deliberately NOT unique per publicUserId: a single account may hold
  /// several subscriptions under different email addresses (e.g. a work and
  /// a personal inbox), so publicUserId is a plain (nullable) foreign key.
  email          String           @unique
  status         NewsletterStatus @default(SUBSCRIBED)
  publicUserId   String?
  publicUser     PublicUser?      @relation(fields: [publicUserId], references: [id], onDelete: SetNull)
  /// Which surface subscribed them — "footer" | "project_page" |
  /// "market_data" | "dashboard" | "referral" | "other".
  source         String?
  subscribedAt   DateTime         @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([subscribedAt])
  @@index([publicUserId])
}

enum EmailCampaignType {
  NEWSLETTER
  RESEARCH_UPDATE
  MARKET_REPORT
  PRODUCT_COMMUNICATION
  REPORT_COMMUNICATION
}

enum EmailCampaignStatus {
  DRAFT
  QUEUED
  SENDING
  SENT
  FAILED
}

/// ACCEPTED means Resend's API accepted the send request — it is NOT delivery
/// confirmation. No provider webhook is wired up (see EmailCampaign's doc
/// comment), so true DELIVERED/BOUNCED/OPENED/CLICKED status is unknowable
/// today; the UI must never claim delivery from this value alone. Named
/// ACCEPTED rather than SENT specifically so nothing in the admin UI can be
/// misread as a delivery guarantee.
enum EmailRecipientStatus {
  PENDING
  ACCEPTED
  FAILED
}

/// Lightweight in-house campaign send, built on the existing Resend wrapper
/// (lib/email.ts) -- no new email provider. v1 is send/delivery tracking
/// only (no open/click pixel or provider webhook), so recipientCount/
/// successCount/failureCount plus each EmailCampaignRecipient row below is
/// the full audit trail; the data model stays extensible if open/click
/// tracking is added later (a nullable openedAt/clickedAt column on the
/// recipient row, no new table).
model EmailCampaign {
  id               String              @id @default(cuid())
  type             EmailCampaignType
  subject          String
  bodyHtml         String
  status           EmailCampaignStatus @default(DRAFT)
  createdByUserId  String
  createdByUser    User                @relation(fields: [createdByUserId], references: [id])
  /// Optional linkage when a campaign is sent in the context of a specific report/project -- e.g. Section 15's resolved-report review-request follow-up.
  relatedReportId  String?
  relatedProjectId String?
  recipientCount   Int                 @default(0)
  successCount     Int                 @default(0)
  failureCount     Int                 @default(0)
  sentAt           DateTime?
  createdAt        DateTime            @default(now())
  deletedAt        DateTime?
  deletedByUserId  String?

  recipients EmailCampaignRecipient[]

  @@index([status, createdAt])
  @@index([deletedAt])
}

/// Per-recipient row, not just a campaign-level count -- Section 18 explicitly
/// requires an auditable recipient list, not only a final aggregate result.
model EmailCampaignRecipient {
  id                String               @id @default(cuid())
  campaignId        String
  campaign          EmailCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  publicUserId      String?
  publicUser        PublicUser?          @relation(fields: [publicUserId], references: [id], onDelete: SetNull)
  email             String
  status            EmailRecipientStatus @default(PENDING)
  sentAt            DateTime?
  /// Resend's own email id when accepted — for support/traceability lookups against Resend's dashboard, never proof of delivery.
  providerMessageId String?
  failureReason     String?

  @@index([campaignId, status])
}

enum ResearchEventType {
  PROJECT_VIEWED
  BUILDER_VIEWED
  LOCALITY_VIEWED
  SEARCH_PERFORMED
  FILTERS_USED
  COMPARE_USED
  WISHLIST_ADDED
  CONTINUE_RESEARCH_CLICKED
  PROFILE_VIEWED
  PROFILE_UPDATED
  NEWSLETTER_VIEWED
  NEWSLETTER_SUBSCRIBED
  NEWSLETTER_UNSUBSCRIBED
  LOCKED_FEATURE_CLICKED
  SIGNUP_COMPLETED
  LOGIN_COMPLETED
  /// Added so Transactions/Market Data/Insights/Reports carry the same first-party
  /// view-tracking that Project/Builder/Locality already had -- previously only
  /// visible in Google Analytics (GAPageEvent), not in this table, so they never
  /// counted toward DAU/WAU/MAU or showed up in the admin's own Research Intent page.
  TRANSACTION_VIEWED
  MARKET_DATA_VIEWED
  INSIGHTS_VIEWED
  REPORT_VIEWED
  /// /transactions (the list page) fired nothing at all despite already having
  /// a full search/filter UI mirroring /projects' -- these three close that
  /// gap the same way SEARCH_PERFORMED/FILTERS_USED already cover /projects.
  TRANSACTION_LIST_VIEWED
  TRANSACTION_SEARCHED
  TRANSACTION_FILTER_APPLIED
  /// Homepage visit, distinct from any specific entity view.
  LANDING_PAGE_VIEWED
  /// A card clicked in a list/grid, distinct from PROJECT_VIEWED (the detail-page landing) --
  /// lets the funnel show "saw the card" vs. "actually opened it" separately.
  PROJECT_CARD_CLICKED
  NOTIFICATION_OPENED
  EMAIL_SENT
  /// A visitor tapped "Share on WhatsApp" on a project page. metadata carries
  /// { source: "whatsapp", device, referringPage, shareId } -- kept in the
  /// existing JSON metadata field rather than new columns, since this is the
  /// only event that needs that context.
  WHATSAPP_SHARE_CLICKED
  /// The general "Share NoDalalTalks" action from /account (any channel).
  /// metadata carries { channel: "whatsapp" | "copy_link" | "native_share" }.
  REFERRAL_SHARE_INITIATED
  /// A visitor landed via someone's ?ref= link -- fired once per first touch
  /// (see the mi_ref_code cookie in app/page.tsx), before/without any signup.
  REFERRAL_LINK_CLICKED
  /// A user typed a locality/landmark into their Research Profile that isn't
  /// in the Locality catalog (LocationsPreferenceForm's free-text field) --
  /// a founder-facing demand signal only (Section 13), never shown to users.
  LOCALITY_INTEREST_ADDED
  /// A user clicked a Notification's action button/CTA -- NOTIFICATION_OPENED
  /// above already covers "opened the bell panel"; this is the distinct,
  /// stronger engagement signal a founder notification campaign's "Clicked"
  /// metric is built from (see Notification.clickedAt, set at the same call site).
  NOTIFICATION_CLICKED
}

/// Site-wide "research intent" log — a deliberately generic single table
/// (not one model per event type) covering every behavioral signal in
/// docs/... analytics ask, mirroring BrochureDownloadEvent's identity model
/// (publicUserId when signed in, sessionId from the same anonymous cookie
/// otherwise) without duplicating its device/browser/UTM richness, since
/// none of these events need that level of detail. `metadata` stays small
/// and non-PII (e.g. a search query string, a list of active filter keys).
model ResearchEvent {
  id           String            @id @default(cuid())
  eventType    ResearchEventType
  /// "Project" | "Builder" | "Locality" | "Transaction" | null for non-entity events (search, profile, newsletter, market data, insights).
  entityType   String?
  entityId     String?
  publicUserId String?
  publicUser   PublicUser?       @relation(fields: [publicUserId], references: [id], onDelete: SetNull)
  sessionId    String?
  metadata     Json?
  /// Set on SEARCH_PERFORMED/TRANSACTION_SEARCHED only -- how many rows the
  /// search actually matched, so a zero-result search (a real product signal:
  /// "users want X, we don't have X") is queryable without parsing metadata.
  resultCount  Int?
  createdAt    DateTime          @default(now())

  @@index([eventType, createdAt])
  @@index([entityType, entityId])
  @@index([publicUserId])
  /// Supports the founder dashboard's DAU/WAU/MAU + 14-day active-users trend
  /// (lib/admin-queries.ts getUserGrowthStats) -- those all filter by a
  /// createdAt range and group by publicUserId; an index-only scan here
  /// keeps that cheap as the event log grows past the small early-stage
  /// volume it's at today.
  @@index([createdAt, publicUserId])
}

